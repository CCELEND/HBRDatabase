/* 全局组件框样式：透明背景 + 浅灰半透明边框 + 白色圆角标题背景 */
QGroupBox {
    background-color: transparent;
    border: 1px solid rgba(200, 200, 200, 120);
    border-radius: 6px;
    margin-top: 10px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 2px 8px;
    background-color: rgba(255, 255, 255, 160);
    border-radius: 4px;
    color: #222222;
}

QGroupBox[smallTitle="true"]::title {
    font-size: 10px;
}

/* BackgroundFrame 内部所有 QWidget 后裔默认透明，避免灰色容器挡住背景图 */
BackgroundFrame QWidget {
    background-color: transparent;
}


/* QComboBox滚动条：透明轨道 + 圆角胶囊滑块 */
/*垂直*/
QComboBox QAbstractItemView QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 4px 1px;
    border-radius: 3px;
}
QComboBox QAbstractItemView QScrollBar::handle:vertical {
    background: rgba(170, 170, 170, 200);
    min-height: 28px;
    border-radius: 3px;
}
QComboBox QAbstractItemView QScrollBar::handle:vertical:hover {
    background: rgba(130, 130, 130, 230);
}
QComboBox QAbstractItemView QScrollBar::add-line:vertical,
QComboBox QAbstractItemView QScrollBar::sub-line:vertical {
    height: 0;
}
QComboBox QAbstractItemView QScrollBar::add-page:vertical,
QComboBox QAbstractItemView QScrollBar::sub-page:vertical {
    background: none;
}
/*水平*/
QComboBox QAbstractItemView QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    margin: 4px 1px;
    border-radius: 3px;
}
QComboBox QAbstractItemView QScrollBar::handle:horizontal {
    background: rgba(170, 170, 170, 200);
    min-width: 28px;
    border-radius: 3px;
}
QComboBox QAbstractItemView QScrollBar::handle:horizontal:hover {
    background: rgba(130, 130, 130, 230);
}
QComboBox QAbstractItemView QScrollBar::add-line:horizontal,
QComboBox QAbstractItemView QScrollBar::sub-line:horizontal {
    width: 0;
}
QComboBox QAbstractItemView QScrollBar::add-page:horizontal,
QComboBox QAbstractItemView QScrollBar::sub-page:horizontal {
    background: none;
}



/* 全局滚动条：透明轨道 + 圆角胶囊滑块 */
/* width: 10px; 对应 border-radius: 4px;  width: 12px; 对应 border-radius: 6px; */
QScrollBar:vertical {
    background: #f0f0f0;
    width: 10px;
    margin: 0px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #c0c0c0;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #a0a0a0;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}
/*水平*/
QScrollBar:horizontal {
    background: #f0f0f0;
    height: 10px;
    margin: 0px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #c0c0c0;
    min-width: 20px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #a0a0a0;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}



